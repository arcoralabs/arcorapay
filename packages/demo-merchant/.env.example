# DEMO-ONLY · TESTNET-ONLY
# Vite inlines VITE_* vars into the built JS bundle — they are public.
# The app refuses to start if the key doesn't begin with `ak_test_`.
# For a production storefront, route through a server (see packages/shop).
VITE_ARC_API_KEY=ak_test_REPLACE_ME_TESTNET_ONLY
VITE_ARC_BASE_URL=http://localhost:3000
