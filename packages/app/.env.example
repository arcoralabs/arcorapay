# Postgres
POSTGRES_URL=postgres://postgres:postgres@localhost:5432/arcfx

# Chain
ARC_TESTNET_RPC=https://rpc.testnet.arc.network

# Active custody-escrow gateway (version-neutral ArcFXGateway). lib/chain/
# client.ts reads this single var and falls back to the ZERO address if it is
# unset — so this MUST be set or every on-chain read/settle silently targets
# 0x000…000. Canonical address: packages/contracts/deployments/arc-testnet.json.
GATEWAY_ADDRESS=0xEaE914D53B2895c832dA83419a7687eF7D1d0142

USDC_ADDRESS=0x3600000000000000000000000000000000000000
EURC_ADDRESS=0x89B50855Aa3bE2F677cD6303Cec089B5F319D72a
ORACLE_ADDRESS=0xF82F7676502935c4B86AAD36F405BfF7a3CA65D3
POOL_ADDRESS=0xC2020098aF328ac9CBD274267F424822C400dD66

# Server hot wallet
MASTER_KEY=                     # 32-byte base64; openssl rand -base64 32

# Server-side relayer binding (NEXT_PUBLIC_RELAYER_ADDRESS is for client display only)
RELAYER_ADDRESS=

# Auth
IRON_SESSION_PASSWORD=          # 32+ chars, openssl rand -base64 32
CRON_SECRET=                    # any random string

# Indexer
INDEXER_REORG_BUFFER_BLOCKS=5

# Public base URL (for invoice URLs)
PUBLIC_BASE_URL=http://localhost:3000

# Rate-limit client-IP trust (audit L-4). Number of trailing x-forwarded-for
# hops added by proxies we control; the IP just left of them is used as the
# per-IP key. Default 1 matches Vercel (which appends the real client IP).
# Only consulted when x-vercel-forwarded-for / x-real-ip are absent.
TRUST_XFF_HOPS=1

# Comma-separated list of ERC-20 addresses accepted as merchant payoutToken
# at bootstrap. If unset, falls back to USDC_ADDRESS + EURC_ADDRESS. Audit L5.
SUPPORTED_PAYOUT_TOKENS=

# Public-side (exposed to browser)
NEXT_PUBLIC_ARC_TESTNET_RPC=https://rpc.testnet.arc.network
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_THIRDWEB_CLIENT_ID=

# Browser components (ClaimAllButton, RefundButton, PayoutTokenCard,
# MerchantActivationCard, DelegateAuthCard, …) all read this single bare var.
# REQUIRED — empty string renders an unusable gateway in the dashboard.
NEXT_PUBLIC_GATEWAY_ADDRESS=0xEaE914D53B2895c832dA83419a7687eF7D1d0142

NEXT_PUBLIC_USDC_ADDRESS=0x3600000000000000000000000000000000000000
NEXT_PUBLIC_EURC_ADDRESS=0x89B50855Aa3bE2F677cD6303Cec089B5F319D72a

# Feature gate for the cross-chain checkout UI; set to "true" to render the chain selector + bridge pay flow.
NEXT_PUBLIC_CROSSCHAIN_ENABLED=

# Cross-chain checkout source-chain RPCs. Production deployments must provide
# both; do not silently fall back to shared public endpoints.
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=
NEXT_PUBLIC_ETHEREUM_SEPOLIA_RPC_URL=
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_SERVER_WALLET_ADDRESS=
