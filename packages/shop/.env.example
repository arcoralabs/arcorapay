# Server-side only — never expose to the client.
# Generate at https://arcorapay.xyz/m/settings → API key.
ARCORA_API_KEY=ak_live_...

# Where Arcora is hosted. Override for staging.
ARCORA_BASE_URL=https://arcorapay.xyz

# Public origin of the shop, used for successUrl/cancelUrl callbacks.
# Vercel sets VERCEL_URL automatically; set this in custom domains.
NEXT_PUBLIC_SHOP_URL=http://localhost:3001
