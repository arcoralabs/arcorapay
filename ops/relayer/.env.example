# V10 relayer env. See ops/vault/README.md for Vault setup.

# ── shared ──────────────────────────────────────────────────────────

# Vault KV-v2 + AppRole for relayer key (audit M1 partial closure, V10).
# Encrypted at rest, audit-logged, AppRole-gated. See ops/vault/README.md.
VAULT_URL=http://127.0.0.1:8200
VAULT_ROLE_ID=
VAULT_SECRET_ID=                 # rotated daily by ops/vault/secret-id-rotation.sh
VAULT_KV_PATH=secret/data/relayer-v10
VAULT_KV_FIELD=privateKey

# Circle Console kit key (sandbox/testnet). Free, takes 1 min to create:
# https://console.circle.com → App Kit → Kit Keys → Create.
KIT_KEY=KIT_KEY:...

# Optional: custom RPC (otherwise viem-default public Arc testnet endpoint).
ARC_TESTNET_RPC=https://rpc.testnet.arc.network

# ── smoke test (Phase A) ────────────────────────────────────────────

# Where the customFee 90% lands. Use any address you control.
FEE_RECIPIENT=0x...

# ── daemon (Phase C+) ───────────────────────────────────────────────

# Postgres (Neon). Same DSN the indexer + webhook daemons use.
POSTGRES_URL_NON_POOLING=postgresql://...

# Deployed Arcora gateway address. The relayer drives a SINGLE active
# contract (it submits new settles + recordPayerRefund here); the indexer
# is the component that dual-watches legacy contracts during a cutover.
# Canonical addresses live in packages/contracts/deployments/arc-testnet.json.
# Current: V11 at 0xEaE914D53B2895c832dA83419a7687eF7D1d0142 (2026-05-13).
GATEWAY_ADDRESS=0xEaE914D53B2895c832dA83419a7687eF7D1d0142

# Recipient of the customFee 90% share that App Kit forwards on every swap.
# Production: this is Arcora treasury. Testing: any owned address.
CUSTOM_FEE_RECIPIENT=0x...

# Permit2 canonical address — the same on every chain (CREATE2-deterministic).
# Override only if the network deploys a different instance.
PERMIT2_ADDRESS=0x000000000022D473030F116dDEE9F6B43aC78BA3

# Daemon tunables.
RELAYER_TICK_MS=5000          # poll every 5 seconds when the queue is empty
RELAYER_MAX_ATTEMPTS=3        # max retries before a row is marked 'failed'
CUSTOM_FEE_BPS=100            # Arcora's spread on every swap (1% default)
SLIPPAGE_BPS=100              # 1% slippage tolerance for kit.swap

# ── Cross-chain v2 Q1 ───────────────────────────────────────────────

# Master switch for crosschain_payments processing. When true,
# CROSSCHAIN_CHAIN_CONFIG_JSON and CCTP_IRIS_API_URL become required and are
# validated at boot.
CROSSCHAIN_ENABLED=true
# Source chains the checkout offers (chain ids, comma-separated).
CROSSCHAIN_ENABLED_SOURCE_CHAINS=84532,11155111
# Per-chain CCTP runtime config, parsed by @arcora/crosschain-core
# parseChainRegistryJson. JSON object keyed by chain key, e.g.
# {"base-sepolia":{"cctpDomain":6,"tokenMessenger":"0x...","messageTransmitter":"0x...","usdcAddress":"0x..."}}
CROSSCHAIN_CHAIN_CONFIG_JSON=
# Circle IRIS attestation API (sandbox for testnet domains).
CCTP_IRIS_API_URL=https://iris-api-sandbox.circle.com
# Retry policy: below the cap a failed row keeps its processable status and
# reschedules with exponential backoff (base * 2^(attempts-1), capped); at
# the cap it gets the terminal *_failed status for operator triage.
CROSSCHAIN_MAX_ATTEMPTS=12
CROSSCHAIN_RETRY_BASE_MS=15000
CROSSCHAIN_RETRY_MAX_MS=900000
# Wall-clock bound on attestation polling, measured from burn_submitted_at.
# Polls don't consume the retry budget (attempts resets while waiting), so
# this deadline is what stops a burn that never attests: past it the row goes
# terminal bridge_failed (attestation_deadline_exceeded). Default 2 hours.
CROSSCHAIN_ATTESTATION_DEADLINE_MS=7200000
# Optional cross-check: the app deployment's relayer address. When set, the
# daemon fails fast at boot if it differs from the Vault-derived signing key.
NEXT_PUBLIC_RELAYER_ADDRESS=

# Source-chain RPC endpoints (required when CROSSCHAIN_ENABLED=true).
BASE_SEPOLIA_RPC=
ETHEREUM_SEPOLIA_RPC=
ARBITRUM_SEPOLIA_RPC=
OPTIMISM_SEPOLIA_RPC=
POLYGON_AMOY_RPC=
AVALANCHE_FUJI_RPC=
LINEA_SEPOLIA_RPC=
