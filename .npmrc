# Vercel build (audit follow-up 2026-06-01). Vercel's npm→pnpm cache flip made
# its Next.js version probe run at the workspace root, where pnpm's default
# isolated (symlinked) node_modules hides `next` → "No Next.js version
# detected". node-linker=hoisted lays out a flat, npm-style node_modules so the
# probe resolves `next`. The app already ran under that fully-hoisted (npm)
# layout for months. Pairs with the dashboard Build Command Override
# (`pnpm --filter @arcora/app build`), which runs next build in packages/app so
# the (root-context) build targets the actual app, not the repo root.
node-linker=hoisted
